<?xml version="1.0" encoding="UTF-8"?>
<!-- Stop sign on road 20 (Ego stops for 2 s) and a 30 km/h speed limit on road 30 that ends on road 31 (Driver) -->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="1" date="2025-01-01T00:00:00" description="Stop sign on road 20 (Ego stops for 2 s) and a 30 km/h speed limit on road 30 that ends on road 31 (Driver)" author="OpenSCENARIO_UE" />
  <ParameterDeclarations />
  <CatalogLocations />
  <RoadNetwork>
    <LogicFile filepath="SignalRoad.xodr" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoCar" vehicleCategory="car">
        <BoundingBox><Center x="1.4" y="0.0" z="0.75" /><Dimensions width="1.8" length="4.5" height="1.5" /></BoundingBox>
        <Performance maxSpeed="60" maxAcceleration="3.5" maxDeceleration="8" />
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Driver">
      <Vehicle name="DriverCar" vehicleCategory="car">
        <BoundingBox><Center x="1.4" y="0.0" z="0.75" /><Dimensions width="1.8" length="4.5" height="1.5" /></BoundingBox>
        <Performance maxSpeed="60" maxAcceleration="3.5" maxDeceleration="8" />
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction><TeleportAction><Position><LanePosition roadId="20" laneId="-1" s="5.0" offset="0.0" /></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" /><SpeedActionTarget><AbsoluteTargetSpeed value="12" /></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
        <Private entityRef="Driver">
          <PrivateAction><TeleportAction><Position><LanePosition roadId="30" laneId="-1" s="2.0" offset="0.0" /></Position></TeleportAction></PrivateAction>
          <PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" /><SpeedActionTarget><AbsoluteTargetSpeed value="20" /></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="MainStory">
      <Act name="MainAct">
        <ManeuverGroup maximumExecutionCount="1" name="DriverGroup">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Driver" /></Actors>
          <Maneuver name="Drive">
            <Event name="Go" priority="overwrite" maximumExecutionCount="1">
                <Action name="Go"><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" /><SpeedActionTarget><AbsoluteTargetSpeed value="20" /></SpeedActionTarget></SpeedAction></LongitudinalAction></PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="Now" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="0" rule="greaterOrEqual" /></ByValueCondition></Condition></ConditionGroup></StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger><ConditionGroup><Condition name="Start" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="0" rule="greaterOrEqual" /></ByValueCondition></Condition></ConditionGroup></StartTrigger>
      </Act>
    </Story>
    <StopTrigger><ConditionGroup><Condition name="Timeout" delay="0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition value="45" rule="greaterThan" /></ByValueCondition></Condition></ConditionGroup></StopTrigger>
  </Storyboard>
</OpenSCENARIO>
